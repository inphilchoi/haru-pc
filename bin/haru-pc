#!/usr/bin/env bash
# haru-pc — everyday commands for Haru PC (a thin layer over OpenClaw with the "haru" profile).
# Sign-ins and keys are entered by YOU on the provider's page or prompt; this script never asks for passwords.
set -euo pipefail

HARU_HOME="${HARU_PC_HOME:-$HOME/.haru-pc}"
PROFILE="${HARU_PC_PROFILE:-haru}"
export PATH="$PATH:$HOME/.local/bin:$HOME/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin"
oc() { openclaw --profile "$PROFILE" "$@"; }
say() { printf '\033[1;35m하루 PC\033[0m %s\n' "$*"; }

usage() {
  cat <<'EOF'
Haru PC — ask Haru on your phone, your computer does the work.

  haru-pc pair                 show a pairing QR code for the Haru app (valid 10 minutes, one use)
  haru-pc approve              approve the phone that is waiting to connect
  haru-pc unpair               disconnect a paired phone
  haru-pc status               is Haru PC running? which phones are paired?
  haru-pc logs                 recent log lines (attach these to a GitHub issue)

  haru-pc model                show the current AI model
  haru-pc model choose         choose a model (menu)
  haru-pc model login chatgpt  sign in with your ChatGPT plan (OpenAI's own page)
  haru-pc model login claude   use your Claude plan (after `claude auth login`) — Anthropic's terms don't allow this; prefer a key
  haru-pc model login grok     sign in with SuperGrok / X Premium (xAI's own page)
  haru-pc model login copilot  sign in with GitHub Copilot
  haru-pc model key <provider> use an API key: chatgpt, claude, gemini, grok, meta, mistral, deepseek…
  haru-pc model local          free local model on this computer
  haru-pc model free           free cloud model (OpenCode Zen "Space Bunny", limited time) — your
                               current model stays as the backup when the free period ends
  haru-pc model check          is the current model answering? which backups are ready?

  haru-pc allow <folder>       let Haru PC work in another folder
  haru-pc readonly on|off      block every change (recommended with small local models)
  haru-pc skills [enable|disable <name>]
  haru-pc relay [on|off|status] connection: Haru relay (default, works anywhere) or off = direct/self-hosted only
  haru-pc relay url <wss://…>  use your own relay (deploy relay/ from the repo to your Cloudflare) — `default` to go back
  haru-pc remote on|off        with the relay off: reach Haru PC away from home through your own Tailscale
  haru-pc update               update to the next tested version
  haru-pc uninstall            stop and remove Haru PC (settings stay in ~/.haru-pc)
EOF
}

# Backups (agents.defaults.model.fallbacks): OpenClaw tries them in order when the main model fails —
# an ended free period (401/403), a removed model, or no internet. $1 is put first; existing ones are kept.
set_fallbacks() {
  local cur; cur="$(oc config get agents.defaults.model.fallbacks 2>/dev/null || echo '[]')"
  local primary; primary="$(oc config get agents.defaults.model.primary 2>/dev/null | tr -d '"{} \n' || true)"
  local new; new="$(printf '%s' "$cur" | node -e '
    let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{
      let a=[];try{a=JSON.parse(s)}catch{};if(!Array.isArray(a))a=[];
      const [first,primary]=process.argv.slice(1);
      const out=[first,...a].filter((m,i,all)=>m&&m!==primary&&all.indexOf(m)===i);
      console.log(JSON.stringify(out))})' "${1:-}" "$primary")"
  oc config set agents.defaults.model.fallbacks "$new" --json >/dev/null
}
fallback_list() {
  oc config get agents.defaults.model.fallbacks 2>/dev/null | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{try{console.log(JSON.parse(s).join(", "))}catch{console.log("")}})'
}

model_choose() {
  cat <<'EOF'
Which AI should Haru PC use?
  1) ChatGPT (OpenAI)      — sign in with your plan, or an API key
  2) Claude (Anthropic)    — API key (plan sign-in isn't allowed by Anthropic's terms)
  3) Gemini (Google)       — API key (free key at aistudio.google.com/apikey)
  4) Grok (xAI)            — sign in with SuperGrok / X Premium, or an API key
  5) Meta (Llama / Muse)   — API key
  6) Free cloud model      — OpenCode Zen "Space Bunny", no sign-up, limited time  (Enter)
  7) GitHub Copilot        — sign in
  8) Other API key         — Mistral, DeepSeek, OpenRouter…
  9) Local model           — free, private, slower (16 GB RAM or more recommended)
Sign-ins happen on each company's own page. Haru PC never asks for your password.
EOF
  read -r -p "Choose 1-9 [6]: " n || n=6
  n="${n:-6}"
  how() {  # $1 = provider; asks sign-in (1) or API key (2)
    local h; read -r -p "  1) Sign in with your account   2) API key   [1]: " h || h=1
    if [ "${h:-1}" = 2 ]; then "$0" model key "$1"; else "$0" model login "$1"; fi
  }
  case "$n" in
    1) how chatgpt ;;
    2) say "Note: Anthropic's terms (Feb 2026) don't allow Claude Free/Pro/Max sign-ins in other tools — an API key is the safe way."
       local h; read -r -p "  1) API key (recommended)   2) Sign in with your Claude plan anyway   [1]: " h || h=1
       if [ "${h:-1}" = 2 ]; then "$0" model login claude; else "$0" model key claude; fi ;;
    3) "$0" model key gemini ;;
    4) how grok ;;
    5) "$0" model key meta ;;
    6) "$0" model free ;;
    7) "$0" model login copilot ;;
    8) read -r -p "Provider (mistral, deepseek, openrouter, …): " p; "$0" model key "$p" ;;
    9) "$0" model local ;;
    *) say "Not a choice — starting with the free model. Change any time: haru-pc model choose"; "$0" model free ;;
  esac
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  # One code for everything: this computer's setup code + the encrypted relay (works away from home too).
  # (Plain `openclaw qr` only works on the same Wi-Fi.)
  pair)      HARU_PC_HOME="$HARU_HOME" HARU_PC_PROFILE="$PROFILE" node "$HARU_HOME/app/plugin/pair.mjs" "$@" ;;
  approve)   oc devices approve --latest ;;
  unpair)    oc devices list; read -r -p "Device id to remove: " id; oc devices remove "$id" ;;
  status)    oc gateway status; oc devices list ;;
  logs)      oc logs --limit 200 2>/dev/null || oc logs ;;

  model)
    sub="${1:-show}"; shift || true
    case "$sub" in
      show)   oc config get agents.defaults.model ;;
      choose) model_choose ;;
      login)
        # A sign-in keeps an existing main model, so clear it first (and put it back if the sign-in fails).
        prev="$(oc config get agents.defaults.model.primary 2>/dev/null | tr -d '"{} \n' || true)"
        switch_to() { oc config unset agents.defaults.model.primary >/dev/null 2>&1 || true; }
        signed_in() {
          now="$(oc config get agents.defaults.model.primary 2>/dev/null | tr -d '"{} \n' || true)"
          if [ -n "$now" ]; then say "Now using: $now"; return 0; fi
          [ -n "$prev" ] && oc config set agents.defaults.model.primary "$prev" >/dev/null
          say "Sign-in didn't finish. Still using: ${prev:-no model}"; return 1
        }
        case "${1:-}" in
          chatgpt|openai)
                   say "OpenAI's sign-in page will open. Enter your ID and password there, not here."
                   switch_to; oc models auth login --provider openai || true; signed_in ;;
          claude|anthropic)
                   say "Anthropic's terms (Feb 2026) don't allow Claude Free/Pro/Max sign-ins in other tools, and accounts can be limited."
                   say "The safe way is an API key: haru-pc model key claude"
                   read -r -p "Use your Claude plan anyway? [y/N] " yn || yn=n
                   case "$yn" in [Yy]*) ;; *) say "OK — run: haru-pc model key claude"; exit 1 ;; esac
                   if ! command -v claude >/dev/null || ! claude auth status >/dev/null 2>&1; then
                     say "First sign in to Claude's official app: run  claude auth login  (you enter your details on Anthropic's page)."
                     exit 1
                   fi
                   oc onboard --non-interactive --accept-risk --skip-health --no-install-daemon --auth-choice anthropic-cli \
                     --workspace "$HARU_HOME/workspace"
                   say "Claude connected. Your Claude plan's limits apply. Please check Anthropic's current terms for using your plan with other tools."
                   signed_in ;;
          grok|xai)
                   say "xAI's sign-in page will open (SuperGrok or X Premium). Enter your details there, not here."
                   switch_to; oc models auth login --provider xai --method oauth || true; signed_in ;;
          copilot) switch_to; oc models auth login-github-copilot || true; signed_in ;;
          gemini|google)
                   say "Google no longer offers account sign-in for tools like this (ended June 18, 2026). Use a free API key instead:"
                   say "  get one at https://aistudio.google.com/apikey, then run: haru-pc model key gemini"; exit 2 ;;
          meta|llama)
                   say "Meta offers API keys only. Run: haru-pc model key meta"; exit 2 ;;
          *) say "Use: haru-pc model login chatgpt|claude|grok|copilot"; exit 2 ;;
        esac ;;
      key)
        p="${1:-}"; [ -n "$p" ] || { say "Use: haru-pc model key <provider>"; exit 2; }
        case "$p" in   # friendly names → OpenClaw's auth choices
          chatgpt|openai) choice=openai-api-key ;;
          claude|anthropic) choice=apiKey ;;
          gemini|google) choice=gemini-api-key ;;
          grok|xai) choice=xai-api-key ;;
          meta|llama) choice=meta-api-key ;;
          *) choice="${p}-api-key" ;;
        esac
        say "Paste your $p API key when asked. It's stored in this computer's secure storage."
        # Some providers keep the current main model on setup (xAI did, 10/1) — clear it so the new key is used,
        # and put the old one back if setup doesn't finish.
        prev="$(oc config get agents.defaults.model.primary 2>/dev/null | tr -d '"{} \n' || true)"
        oc config unset agents.defaults.model.primary >/dev/null 2>&1 || true
        oc onboard --auth-choice "$choice" --skip-health --no-install-daemon --workspace "$HARU_HOME/workspace" || true
        now="$(oc config get agents.defaults.model.primary 2>/dev/null | tr -d '"{} \n' || true)"
        if [ -n "$now" ]; then say "Now using: $now"
        else [ -n "$prev" ] && oc config set agents.defaults.model.primary "$prev" >/dev/null; say "Key setup didn't finish. Still using: ${prev:-no model}"; exit 1; fi ;;
      free)
        # OpenCode Zen's free models need no account: the key "public" is what opencode itself sends.
        # The free period has no announced end, so the model you had before becomes the backup —
        # when Zen stops answering (401), OpenClaw moves on to it (checked 2026-10-01).
        free="opencode/space-bunny-free"
        prev="$(oc config get agents.defaults.model.primary 2>/dev/null | tr -d '"{} \n' || true)"
        oc onboard --non-interactive --accept-risk --skip-health --no-install-daemon \
          --auth-choice opencode-zen --opencode-zen-api-key public --workspace "$HARU_HOME/workspace" >/dev/null
        oc config set agents.defaults.model.primary "$free" >/dev/null
        [ "$prev" = "$free" ] && prev=""
        set_fallbacks "$prev"
        backups="$(fallback_list)"
        if [ -n "$backups" ]; then
          say "Free model on. If it stops answering, Haru PC uses: $backups"
        else
          say "Free model on. It's free for a limited time — when it ends, choose another AI with: haru-pc model choose"
        fi
        say "Your messages to Haru PC go through OpenCode's servers (they say: not stored, not used for training)." ;;
      check)
        primary="$(oc config get agents.defaults.model.primary 2>/dev/null | tr -d '"{} \n' || true)"
        say "Main model: ${primary:-not chosen}   Backups: $(fallback_list)"
        for mdl in $primary $(fallback_list | tr ',' ' '); do
          if oc infer model run --local --model "$mdl" --prompt "Reply with OK" 2>/dev/null | grep -qi "ok"; then say "  ✓ $mdl answers"; else say "  ✗ $mdl does not answer"; fi
        done ;;
      local)
        oc plugins install @openclaw/llama-cpp-provider --accept-capabilities >/dev/null 2>&1 || true
        oc onboard --auth-choice llama-cpp --skip-health --no-install-daemon --workspace "$HARU_HOME/workspace"
        say "Small local models are easier to trick, so Haru PC turns on read-only mode. Turn it off with: haru-pc readonly off"
        oc config set plugins.entries.haru-pc.config.readOnly true >/dev/null ;;
      *) usage; exit 2 ;;
    esac ;;

  allow)
    f="${1:-}"; [ -d "$f" ] || { say "Folder not found: $f"; exit 2; }
    f="$(cd "$f" && pwd)"
    cur="$(oc config get plugins.entries.haru-pc.config.allowedFolders 2>/dev/null || echo '[]')"
    new="$(printf '%s' "$cur" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{let a=[];try{a=JSON.parse(s)}catch{};if(!Array.isArray(a)||!a.length){const h=require("os").homedir();a=["Documents","Downloads","Desktop"].map(d=>h+"/"+d).concat(h+"/.haru-pc/workspace")}if(!a.includes(process.argv[1]))a.push(process.argv[1]);console.log(JSON.stringify(a))})' "$f")"
    oc config set plugins.entries.haru-pc.config.allowedFolders "$new" --json >/dev/null && say "Haru PC may now work in: $f" ;;
  readonly)
    case "${1:-}" in on) v=true ;; off) v=false ;; *) say "Use: haru-pc readonly on|off"; exit 2 ;; esac
    oc config set plugins.entries.haru-pc.config.readOnly "$v" --json >/dev/null && say "Read-only: ${1}" ;;
  skills)
    case "${1:-list}" in
      list) oc skills list ;;
      enable|disable) oc config set "skills.entries.${2:?skill name}.enabled" "$([ "$1" = enable ] && echo true || echo false)" --json >/dev/null && say "${2}: ${1}d" ;;
      *) say "Use: haru-pc skills [enable|disable <name>]"; exit 2 ;;
    esac ;;
  relay)
    # How the phone reaches this computer: Haru relay (default) or self-hosted/direct.
    if [ -z "${1:-}" ] || [ "$1" = status ]; then
      HARU_PC_HOME="$HARU_HOME" node "$HARU_HOME/app/plugin/relay-config.mjs" status
    else
      HARU_PC_HOME="$HARU_HOME" node "$HARU_HOME/app/plugin/relay-config.mjs" "$@" && oc gateway restart >/dev/null 2>&1 || true
    fi ;;
  remote)
    case "${1:-}" in
      on)  command -v tailscale >/dev/null || { say "Install Tailscale first: https://tailscale.com/download"; exit 1; }
           oc config set gateway.tailscale.mode serve >/dev/null && oc gateway restart >/dev/null && say "Reachable inside your tailnet only. Pair again with: haru-pc pair --remote" ;;
      off) oc config set gateway.tailscale.mode off >/dev/null && oc gateway restart >/dev/null && say "Remote access off." ;;
      *) say "Use: haru-pc remote on|off"; exit 2 ;;
    esac ;;
  update)    curl -fsSL https://raw.githubusercontent.com/inphilchoi/haru-pc/main/install.sh | bash ;;
  uninstall) oc gateway uninstall || true; rm -f "$HOME/.local/bin/haru-pc"; rm -rf "$HARU_HOME/app"
             say "Removed. Your settings and workspace are still in $HARU_HOME and ~/.openclaw-$PROFILE — delete them to remove everything." ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
